{
  "info": {
    "name": "CreditSense Underwriting API",
    "description": "Production-grade SME credit scoring and regulatory compliance checking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains app name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.app).to.eql(\"CreditSense\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Credit Risk Prediction",
      "item": [
        {
          "name": "Predict Credit Risk - Low Risk Applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annual_revenue\": 25000000,\n  \"debt_to_equity\": 0.8,\n  \"revenue_growth_yoy\": 0.15,\n  \"operating_margin\": 0.18,\n  \"years_in_business\": 10,\n  \"late_payment_count\": 0,\n  \"collateral_coverage_ratio\": 1.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/predict/credit-risk",
              "host": ["{{base_url}}"],
              "path": ["predict", "credit-risk"]
            }
          }
        },
        {
          "name": "Predict Credit Risk - High Risk Applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annual_revenue\": 8000000,\n  \"debt_to_equity\": 3.5,\n  \"revenue_growth_yoy\": 0.05,\n  \"operating_margin\": 0.08,\n  \"years_in_business\": 2,\n  \"late_payment_count\": 4,\n  \"collateral_coverage_ratio\": 0.7\n}"
            },
            "url": {
              "raw": "{{base_url}}/predict/credit-risk",
              "host": ["{{base_url}}"],
              "path": ["predict", "credit-risk"]
            }
          }
        }
      ]
    },
    {
      "name": "Full Underwriting Orchestration",
      "item": [
        {
          "name": "Submit Underwriting - Low Risk Compliant (Approve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains decision\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.final_decision).to.have.property('approved');",
                  "});",
                  "pm.test(\"Compliance flags exist\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.compliance).to.have.property('flags');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_id\": \"POSTMAN-LOW-001\",\n  \"annual_revenue\": 25000000,\n  \"debt_to_equity\": 0.8,\n  \"revenue_growth_yoy\": 0.15,\n  \"operating_margin\": 0.18,\n  \"years_in_business\": 10,\n  \"late_payment_count\": 0,\n  \"collateral_coverage_ratio\": 1.5,\n  \"notes\": \"Profitable manufacturing firm with excellent collateral and zero delinquencies.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/submit/underwriting",
              "host": ["{{base_url}}"],
              "path": ["submit", "underwriting"]
            }
          }
        },
        {
          "name": "Submit Underwriting - High Leverage (Escalate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has compliance flags\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.compliance.flags.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test(\"Flags have source citations\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.compliance.flags.forEach(function(flag) {",
                  "        pm.expect(flag).to.have.property('source');",
                  "        pm.expect(flag.source).to.have.property('regulation_number');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_id\": \"POSTMAN-HIGH-001\",\n  \"annual_revenue\": 10000000,\n  \"debt_to_equity\": 3.5,\n  \"revenue_growth_yoy\": 0.05,\n  \"operating_margin\": 0.08,\n  \"years_in_business\": 2,\n  \"late_payment_count\": 4,\n  \"collateral_coverage_ratio\": 0.7,\n  \"notes\": \"Highly leveraged startup with weak collateral and persistent delinquency issues.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/submit/underwriting",
              "host": ["{{base_url}}"],
              "path": ["submit", "underwriting"]
            }
          }
        },
        {
          "name": "Submit Underwriting - Moderate Risk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_id\": \"POSTMAN-MOD-001\",\n  \"annual_revenue\": 15000000,\n  \"debt_to_equity\": 1.5,\n  \"revenue_growth_yoy\": 0.12,\n  \"operating_margin\": 0.15,\n  \"years_in_business\": 6,\n  \"late_payment_count\": 1,\n  \"collateral_coverage_ratio\": 1.3,\n  \"notes\": \"Established retail business with seasonal cash flow patterns.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/submit/underwriting",
              "host": ["{{base_url}}"],
              "path": ["submit", "underwriting"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
}
